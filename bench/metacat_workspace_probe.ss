;; Canonical dump of the workspace right after initialisation.
(define *metacat-source-dir* "scheme/metacat/")
(load "scheme/headless/prelude.ss")
(load "scheme/headless/shared-rng.ss")
(load "scheme/headless/load-core.ss")
(load "scheme/headless/harness.ss")

(define num->str
  (lambda (v)
    (if (exact? v)
      (if (integer? v) (number->string v)
        (format "~a/~a" (numerator v) (denominator v)))
      (number->string v))))

(define nm (lambda (n) (if (exists? n) (tell n 'get-lowercase-name) "-")))

(define probe-problem
  (lambda (i m t)
    (printf "PROBLEM\t~a\t~a\t~a~%" i m t)
    (for* each node in *slipnet-nodes* do (tell node 'reset))
    (init-workspace i m t #f)
    (add-string-position-descriptions-to-letters *initial-string*)
    (add-string-position-descriptions-to-letters *modified-string*)
    (add-string-position-descriptions-to-letters *target-string*)
    (if* (or (= (tell *initial-string* 'get-length) 1)
             (= (tell *modified-string* 'get-length) 1)
             (= (tell *target-string* 'get-length) 1))
      (tell plato-object-category 'set-activation %max-activation%))
    (for* each obj in (tell *workspace* 'get-objects) do
      (for* each descriptor in (tell-all (tell obj 'get-descriptions) 'get-descriptor)
        do (tell descriptor 'set-activation %max-activation%)))
    (update-workspace-values)
    (clamp-initial-slipnodes)
    (for-each
      (lambda (string)
        (printf "STRING\t~a\t~a\t~a\t~a~%"
          (tell string 'get-string-type) (tell string 'print-name)
          (tell string 'get-length)
          (tell string 'get-average-intra-string-unhappiness))
        (for-each
          (lambda (obj)
            (printf "OBJ\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a~%"
              (tell string 'get-string-type) (tell obj 'ascii-name)
              (tell obj 'get-id-num) (tell obj 'get-string-pos)
              (num->str (tell obj 'get-raw-importance))
              (tell obj 'get-relative-importance)
              (tell obj 'get-intra-string-unhappiness)
              (tell obj 'get-inter-string-unhappiness 'horizontal)
              (tell obj 'get-inter-string-unhappiness 'vertical)
              (tell obj 'get-average-unhappiness)
              (tell obj 'get-intra-string-salience)
              (tell obj 'get-inter-string-salience 'horizontal)
              (tell obj 'get-inter-string-salience 'vertical)
              (tell obj 'get-average-salience)
              (if (tell obj 'leftmost-in-string?) "L" "-")
              (if (tell obj 'rightmost-in-string?) "R" "-"))
            (let loop ((k 0) (ds (tell obj 'get-descriptions)))
              (when (not (null? ds))
                (let ((d (1st ds)))
                  (printf "DESC\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a~%"
                    (tell string 'get-string-type) (tell obj 'ascii-name) k
                    (nm (tell d 'get-description-type)) (nm (tell d 'get-descriptor))
                    (tell d 'get-proposal-level) (tell d 'get-strength)
                    (num->str (tell d 'calculate-internal-strength))
                    (num->str (tell d 'calculate-external-strength))
                    (tell d 'calculate-local-support)))
                (loop (+ k 1) (rest ds)))))
          (tell string 'get-objects)))
      (list *initial-string* *modified-string* *target-string*))
    (for-each
      (lambda (node)
        (if* (not (= 0 (tell node 'get-activation)))
          (printf "SLIPACT\t~a\t~a\t~a~%" (nm node) (tell node 'get-activation)
            (if (tell node 'frozen?) "frozen" "-"))))
      *slipnet-nodes*)))

(probe-problem 'abc 'abd 'ijk)
(probe-problem 'abc 'cba 'pqrs)
(probe-problem 'a 'b 'xyz)
(probe-problem 'abc 'abd 'mrrjjj)
